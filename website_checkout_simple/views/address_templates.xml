<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="address_hide_country" inherit_id="website_sale.address">

        <!-- Country stays defaulted to Argentina (controllers/main.py) but is
             never something the customer needs to see or touch. address.js
             never toggles this div's visibility, so a static class is safe. -->
        <xpath expr="//div[@id='div_country']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <!-- Collapse the optional address fields behind a toggle, using
             Bootstrap's native multi-collapse (shared class + data-bs-target),
             no custom JS. Each div keeps its id and stays in the DOM, so
             address.js's parentElement-based show/hide logic is unaffected. -->
        <xpath expr="//div[@id='div_street']" position="before">
            <div class="w-100"/>
            <div class="col-lg-12 mb-2">
                <a
                    href="#"
                    role="button"
                    class="o_wsale_optional_address_toggle"
                    data-bs-toggle="collapse"
                    data-bs-target=".o_wsale_optional_address"
                    aria-expanded="false"
                >
                    ¿Querés que te lo enviemos? Agregá tu dirección (opcional)
                </a>
            </div>
        </xpath>
        <xpath expr="//div[@id='div_street']" position="attributes">
            <attribute name="class" add="collapse o_wsale_optional_address" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='div_street2']" position="attributes">
            <attribute name="class" add="collapse o_wsale_optional_address" separator=" "/>
        </xpath>
        <xpath expr="(//div[@id='div_zip'])[1]" position="attributes">
            <attribute name="class" add="collapse o_wsale_optional_address" separator=" "/>
        </xpath>
        <xpath expr="(//div[@id='div_zip'])[2]" position="attributes">
            <attribute name="class" add="collapse o_wsale_optional_address" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='div_city']" position="attributes">
            <attribute name="class" add="collapse o_wsale_optional_address" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='div_state']" position="attributes">
            <attribute name="class" add="collapse o_wsale_optional_address" separator=" "/>
        </xpath>

    </template>

</odoo>
