<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template
        id="thank_you_whatsapp_button"
        inherit_id="website_sale_checkout_no_payment.thank_you"
        name="Add WhatsApp button to the thank-you page">
        <xpath expr="//div[@id='oe_structure_website_sale_checkout_no_payment_thank_you']" position="before">
            <div class="text-center mt-4">
                <a
                    t-att-href="whatsapp_url"
                    class="btn btn-lg btn-success d-inline-flex align-items-center justify-content-center"
                    role="button"
                    target="_blank">
                    <i class="fa fa-whatsapp me-2 fs-4"/>
                    <span class="fs-4">Coordinar por WhatsApp</span>
                </a>
            </div>
        </xpath>
    </template>
</odoo>
